{
  "name": "albor",
  "version-semver": "0.1.0",
  "description": "Cross-platform declarative UI framework for C++",
  "homepage": "https://github.com/AlborCore/albor",
  "license": "Apache-2.0",
  "supports": "((osx | windows) & !mingw & !uwp)",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "harfbuzz",
      "platform": "osx",
      "features": [
        "icu",
        "coretext"
      ]
    },
    {
      "name": "harfbuzz",
      "platform": "windows",
      "features": [
        "icu",
        "directwrite",
        "gdi"
      ]
    },
    {
      "name": "harfbuzz",
      "platform": "linux",
      "features": [
        "icu"
      ]
    },
    {
      "name": "freetype"
    },
    {
      "name": "bzip2"
    },
    {
      "name": "icu"
    },
    {
      "name": "libpng"
    },
    {
      "name": "zlib",
      "version>=": "1.3.2"
    }
  ],
  "features": {
    "blend2d": {
      "description": "The portable Blend2D CPU renderer with the albor-blend2d umbrella",
      "dependencies": [
        {
          "name": "blend2d",
          "version>=": "2025-03-08#1",
          "default-features": false,
          "features": [
            "jit"
          ]
        }
      ]
    }
  }
}
