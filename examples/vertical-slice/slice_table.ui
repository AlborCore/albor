import slice_row;

// the shared table page of the first vertical slice, which combines a virtualized list with a declarative chart (§8, §28)

component SliceTable {
    in property<vector<SliceRow>> rows: [SliceRow { key: "r1", title: "R1   1.0 ohm" }, SliceRow { key: "r2", title: "R2   2.2 ohm" }, SliceRow { key: "r3", title: "C1   10 nF" }, SliceRow { key: "r4", title: "L1   1 mH" }, SliceRow { key: "r5", title: "V1   DC 5" }];

    Panel {
        padding: 12px;

        Column {
            spacing: 10px;

            Label {
                text: "Netlist elements";
                font_size: 18px;
            }

            ListBox {
                id: slice_rows;
                viewport_width: 460px;
                viewport_height: 120px;
                row_height: 24px;
                overscan: 32px;
                scrollbar: Scrollbar.on;

                Repeat(row in rows) {
                    Label { text: row.title; }
                }
            }

            Label {
                text: "Impedance sweep";
                font_size: 18px;
            }

            Canvas {
                id: slice_chart;
                width: 460px;
                height: 170px;

                draw: {
                    fill_rect(0, 0, canvas_width, canvas_height, #10141C);
                    stroke_rect(24, 8, canvas_width - 32, 132, 1, #445066);
                    stroke_line(24, 40, canvas_width - 8, 40, 1, #263042);
                    stroke_line(24, 72, canvas_width - 8, 72, 1, #263042);
                    stroke_line(24, 104, canvas_width - 8, 104, 1, #263042);
                    stroke_line(120, 8, 120, 140, 1, #263042);
                    stroke_line(216, 8, 216, 140, 1, #263042);
                    stroke_line(312, 8, 312, 140, 1, #263042);
                    stroke_line(24, 112, 80, 104, 1, #33BF73);
                    stroke_line(80, 104, 136, 88, 1, #33BF73);
                    stroke_line(136, 88, 192, 64, 1, #33BF73);
                    stroke_line(192, 64, 248, 44, 1, #33BF73);
                    stroke_line(248, 44, 304, 34, 1, #33BF73);
                    stroke_line(304, 34, 360, 30, 1, #33BF73);
                    stroke_line(360, 30, 420, 28, 1, #33BF73);
                    fill_circle(136, 88, 4, #33BF73);
                    stroke_circle(248, 44, 5, 2, #33BF73);
                    draw_text("impedance", 32, 12, 12, #D4D6DE);
                    fill_rect(measure_text("impedance", 12) + 40, 14, 6, 6, #33BF73);
                    draw_text("1 Hz", 104, 144, 10, #7A8296);
                    draw_text("1 kHz", 200, 144, 10, #7A8296);
                    draw_text("1 MHz", 296, 144, 10, #7A8296);
                    draw_image(@image("icon.png"), 420, 8, 24, 24, #FFFFFF);
                }
            }
        }
    }
}
