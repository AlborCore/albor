// the widget form, which exercises every widget the framework ships and is compiled into a facade (§8, §11.3)
import todo;

// the form is the test bed and the showcase, so it is declarative and nothing here is hand written (§14)
component WidgetForm {
    inout property<int> presses: 0;
    inout property<float> level: 0.5;
    inout property<bool> armed: false;
    inout property<string> name: "";
    inout property<int> mode: 0;
    inout property<int> plot: 0;
    inout property<float> effort: 30.0;
    inout property<vector<Todo>> todos: [];

    Column {
        spacing: 12px;
        padding: 16px;

        Label {
            id: form_title;
            text: "Widget Form";
            font_size: 24px;
        }
    
        Label {
            id: form_presses;
            text: "presses " + string(presses);
        }

        Button {
            id: form_press;
            text: "press me";
            disabled: armed;
            on_clicked: {
                presses = presses + 1;
            }
        }

        Label {
            id: form_value;
            text: "value " + string(level);
        }

        Label {
            id: form_progress_label;
            text: "progress";
        }

        ProgressBar {
            id: form_progress;
            value: level;
            disabled: armed;
        }

        Slider {
            id: form_level;
            value: level;
            disabled: armed;
            min: 0.0;
            max: 1.0;
            on_changed: {
                level = value;
            }
        }

        Canvas {
            id: form_meter;
            width: 380px;
            height: 20px;
            draw: {
                fill_rect(0, 0, canvas_width, canvas_height, #D4D6DE);
                fill_rect(0, 0, canvas_width * level, canvas_height, #0A82FF);
            }
        }

        Label {
            id: form_mode_label;
            text: "pick a mode";
        }

        RadioGroup {
            id: form_modes;
            selected: mode;
            vertical: false;
            spacing: 16px;
            on_selection_changed: {
                mode = value;
            }

            RadioButton {
                id: form_mode_fast;
                value: 0;
                label: "Fast";
                disabled: armed;
            }

            RadioButton {
                id: form_mode_balanced;
                value: 1;
                label: "Balanced";
                disabled: armed;
            }

            RadioButton {
                id: form_mode_safe;
                value: 2;
                label: "Safe";
                disabled: armed;
            }
        }

        Label {
            id: form_mode_value;
            text: "mode " + string(mode);
        }

        Label {
            id: form_plot_label;
            text: "plot " + string(plot);
        }

        ComboBox {
            id: form_plot;
            items: ["Waveform", "Spectrum", "Constellation"];
            selected: plot;
            label: "Plot view";
            placeholder: "Choose a plot view";
            disabled: armed;
            on_selection_changed: {
                plot = index;
            }
        }

        Label {
            id: form_effort_label;
            text: "effort " + string(effort);
        }

        NumericStepper {
            id: form_effort;
            value: effort;
            min: 0.0;
            max: 100.0;
            step: 5.0;
            disabled: armed;
            on_changed: {
                effort = value;
            }
        }

        Label {
            id: form_toggle;
            text: "check to disable the controls";
        }

        CheckBox {
            id: form_armed;
            checked: armed;
            on_toggled: {
                armed = checked;
            }
        }

        Label {
            id: form_name_label;
            text: "who is this form for?";
        }

        TextField {
            id: form_name;
            value: name;
            placeholder: "type a name";
            disabled: armed;
            on_changed: {
                name = value;
            }
            on_committed: {
                presses = presses + 1;
            }
        }

        Label {
            id: form_name_value;
            text: "typed " + string(name);
        }

        ListBox {
            id: form_list;
            viewport_width: 320px;
            viewport_height: 160px;
            row_height: 24px;
            overscan: 48px;
            scrollbar: Scrollbar.as_needed;
            selected: 0;

            on_selection_changed: {
            }

            on_activated: {
            }

            Repeat(todo in todos) {
                Label { text: todo.title; }
            }
        }
    }
}