// the function fixture, which proves a ui-declared function compiles into a facade (§11.1)

fn tick_step(low: float, high: float): float {
    return (high - low) / 10.0;
}

component FnPanel {
    in property<float> low;
    in property<float> high;

    Column {
        Label {
            text: string(tick_step(low, high));
        }
    }
}
