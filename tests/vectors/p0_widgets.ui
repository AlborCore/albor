// the application-readiness P0 fixture, which proves the new surface compiles into a facade (AGENTS.md, §14.2)

component P0Widgets {
    inout property<int> selected: 0;
    in property<vector<TextDecoration>> tokens: [];
    command save "Save";

    Column {
        spacing: 8px;

        Column {
            spacing: 8px;

            MenuBar {
                MenuItem {
                    id: menu_save;
                    text: "Save";
                    command: save;
                }
                MenuItem {
                    id: menu_close;
                    text: "Close";
                }
            }

            Menu {
                id: file_menu;
                MenuItem {
                    id: file_save;
                    text: "Save";
                    command: save;
                }
                MenuSeparator {}
                MenuItem {
                    id: file_close;
                    text: "Close";
                    shortcut: "Cmd+W";
                }
            }

            ToolBar {
                Button {
                    id: toolbar_save;
                    text: "Save";
                    command: save;
                }
            }
        }

        Panel {
            id: settings_panel;
            padding: 12px;
            spacing: 4px;
            background: #112233;
            corner_radius: 6px;
            border_width: 1px;

            Column {
                Label { text: "Panel"; }

                Label {
                    id: styled_label;
                    text: "Styled";
                    opacity: 0.75;
                    border_width: 2px;
                    border_color: #445566;
                    drop_shadow: Shadow { color: #00000040, offset: Point { x: 0px, y: 2px }, blur: 4px };
                }
            }
        }

        Card {
            padding: 8px;

            Column {
                Label { text: "Card"; }
            }
        }

        ComboBox {
            id: choice;
            items: ["Alpha", "Beta", "Gamma"];
            selected: selected;
            label: "Choice";
            placeholder: "Choose";
            on_selection_changed: { selected = index; }
        }

        Button {
            id: icon_button;
            text: "Save";
            icon: @image("icon.png");
            icon_size: 16px;
            command: save;
        }

        Button {
            id: save_toolbar_button;
            text: "Save";
            command: save;
        }

        TextField {
            id: netlist;
            value: "line 1";
            decorations: [TextDecoration { start: 0, end: 4, foreground: #FF0000, underline: true }];
        }
    }
}
