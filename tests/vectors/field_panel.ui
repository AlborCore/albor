// the field-write and record-payload fixture, which proves a handler writes one field and a signal carries a record (§11.1)

struct Frame {
    float width;
    float height;
}

component FieldPanel {
    inout property<Frame> frame;

    signal frame_changed(Frame frame);

    Column {
        Button {
            text: "set width";

            on_clicked: {
                frame.width = 10.0;
                frame_changed(frame);
            }
        }
    }
}
