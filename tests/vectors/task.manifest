// the record fixture, which declares the shape a list of tasks carries (§11.2, AD-17, AD-13)

record Task {
    key: string;
    title: string;
    done: bool = false;
}

// the image record fixture, which proves a manifest record can carry a decoded handle (§6.4, §11.2)

record ImageRecord {
    key: string;
    icon: image;
}
