# the shared build rules for generated components, which the examples and the fixtures use (§14.2, §14.3)
include_guard(GLOBAL)

# resolve one codegen driver, which the build tree carries as a target and an installed package ships beside its libraries (AD-19)
function(_albor_driver out_command out_dependency tool_name)
    # a documented per-tool pin answers before everything else, which hermetic builders and sysroots use (AD-19)
    string(TOUPPER "${tool_name}" tool_upper)
    string(REPLACE "-" "_" tool_upper "${tool_upper}")
    if(DEFINED ${tool_upper}_EXECUTABLE)
        # an override that names nothing is a mistake, which is reported rather than silently accepted (AD-19)
        if(NOT EXISTS "${${tool_upper}_EXECUTABLE}")
            message(FATAL_ERROR "albor component helpers: the override ${tool_upper}_EXECUTABLE points at '${${tool_upper}_EXECUTABLE}', which does not exist")
        endif()
        set(${out_command} "${${tool_upper}_EXECUTABLE}" PARENT_SCOPE)
        set(${out_dependency} "${${tool_upper}_EXECUTABLE}" PARENT_SCOPE)
        return()
    endif()
    # the framework's own build tree owns the fresh tool, which the generator expression names and the build orders on (§14.2)
    if(TARGET "${tool_name}")
        set(${out_command} "$<TARGET_FILE:${tool_name}>" PARENT_SCOPE)
        set(${out_dependency} "${tool_name}" PARENT_SCOPE)
        return()
    endif()
    # the installed package's config defines ALBOR_TOOL_DIR, its tools prefix beside the libraries the code links (AD-19)
    if(NOT EXISTS "${ALBOR_TOOL_DIR}")
        message(FATAL_ERROR "albor component helpers: '${tool_name}' is neither a build target (is tools/ registered before this directory?) nor an installed tool (ALBOR_TOOL_DIR)")
    endif()
    # the search is bound to the prefix, because a different tool from PATH would compile generated code against a foreign package (AD-19)
    string(MAKE_C_IDENTIFIER "${tool_name}" driver)
    find_program(${driver}_EXECUTABLE NAMES "${tool_name}" PATHS "${ALBOR_TOOL_DIR}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
    # a missing executable after a bounded search is a broken package, which is reported at configure rather than at build (AD-19)
    if(NOT ${driver}_EXECUTABLE)
        message(FATAL_ERROR "albor component helpers: the package's tools prefix '${ALBOR_TOOL_DIR}' does not provide '${tool_name}'")
    endif()
    # the executable itself joins the dependency graph, so a package upgrade regenerates every unit it touched (AD-19)
    set(${out_command} "${${driver}_EXECUTABLE}" PARENT_SCOPE)
    set(${out_dependency} "${${driver}_EXECUTABLE}" PARENT_SCOPE)
endfunction()

# the snake case unit stem of a component class, which is how the generated files are named (§11.3)
function(albor_component_stem out_var class_name)
    # an upper case letter after text starts a word, which the underscore marks (§11.3)
    string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" stem "${class_name}")
    # the letters lower, because the file base is lower case (§11.3)
    string(TOLOWER "${stem}" stem)
    set(${out_var} "${stem}" PARENT_SCOPE)
endfunction()

# generate the font registration unit of one target, which carries the declared faces into its binary (§11.3, AD-34)
function(albor_build_font_assets target)
    # the arguments name a default family and the faces the target carries (§9.1, AD-34)
    cmake_parse_arguments(FONT "" "DEFAULT" "FONTS" ${ARGN})
    # a helper without a target has nothing to attach the unit to (§14.2)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "albor_build_font_assets: '${target}' is not a target")
    endif()
    # an argument the helper does not understand is a build mistake, which is reported rather than ignored (§14.2)
    if(FONT_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "albor_build_font_assets: '${target}' has unparsed arguments: ${FONT_UNPARSED_ARGUMENTS}")
    endif()
    # a second call would add a second rule for the same outputs, which ninja refuses (§14.2)
    get_target_property(existing_fonts ${target} ALBOR_FONT_ASSETS)
    if(existing_fonts)
        message(FATAL_ERROR "albor_build_font_assets: '${target}' already declares its font assets")
    endif()
    # the ui helper reads the font list when it runs, so the fonts must be declared before it (§11.1, §11.3)
    get_target_property(ui_generated ${target} ALBOR_UI_COMPONENT_GENERATED)
    if(ui_generated)
        message(FATAL_ERROR "albor_build_font_assets: call it before albor_build_ui_component for '${target}'")
    endif()
    # a helper without a default family cannot name a bare selection (§9.1)
    if(NOT FONT_DEFAULT)
        message(FATAL_ERROR "albor_build_font_assets: '${target}' needs DEFAULT <family>")
    endif()
    # a helper without a face cannot generate a registration unit (§11.3)
    if(NOT FONT_FONTS)
        message(FATAL_ERROR "albor_build_font_assets: '${target}' needs at least one FONTS entry")
    endif()
    # every face is a family, a weight and a file, so the list must be a multiple of three (§11.3)
    list(LENGTH FONT_FONTS count)
    math(EXPR remainder "${count} % 3")
    if(NOT remainder EQUAL 0)
        message(FATAL_ERROR "albor_build_font_assets: '${target}' FONTS needs <family> <weight> <file> triples")
    endif()
    # the generated unit lands in the target directory, which the build owns (§14.2)
    set(generated_dir "${CMAKE_BINARY_DIR}/generated/${target}")
    # the codegen flags and the file dependencies are assembled from the triples (§11.3)
    set(font_args "")
    set(font_files "")
    # three entries at a time name one face, in the order the build wrote it (§9.1)
    math(EXPR last_index "${count} - 1")
    foreach(index RANGE 0 ${last_index} 3)
        # the triple starts at the index, because the list is flat (§11.3)
        list(GET FONT_FONTS ${index} family)
        # the weight follows the family, because one face is family, weight and file (§9.1)
        math(EXPR weight_index "${index} + 1")
        list(GET FONT_FONTS ${weight_index} weight)
        # the file follows the weight, because the build reads the bytes from it (§11.3)
        math(EXPR file_index "${index} + 2")
        list(GET FONT_FONTS ${file_index} file)
        # a relative file is resolved against the caller's source directory, because the command runs in the build (§14.2)
        get_filename_component(file "${file}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        # a file that is not there cannot be embedded, so the build reports it before the tool runs (§11.3)
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "albor_build_font_assets: '${target}' cannot find '${file}'")
        endif()
        # the codegen flags carry the face, which the compiler validates against the ui (§11.1, AD-34)
        list(APPEND font_args --font "${family}" "${weight}" "${file}")
        # the file is a dependency, because a changed face must regenerate the unit (§14.2)
        list(APPEND font_files "${file}")
    endforeach()
    # the target carries the declaration for the ui component helper, which passes the same list to codegen (§11.1, §11.3)
    set_target_properties(${target} PROPERTIES ALBOR_FONT_ASSETS "${font_args}" ALBOR_DEFAULT_FONT_FAMILY "${FONT_DEFAULT}")
    # the stamp records that the tool ran, because an unchanged file is not rewritten and would leave the rule older (§14.2)
    set(stamp "${generated_dir}/albor_embedded_fonts.stamp")
    # the font command resolves from the build tree's target or the installed package's tools (AD-19)
    _albor_driver(font_command font_dependency albor-font-embed)
    # the generated files are the output of the embedding tool, which writes only when content changed (§14.2)
    set(units "${generated_dir}/albor_embedded_fonts.h" "${generated_dir}/albor_embedded_fonts.cpp")
    add_custom_command(
        OUTPUT ${units} "${stamp}"
        COMMAND ${font_command} --output "${generated_dir}" --default-family "${FONT_DEFAULT}" ${font_args}
        COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}"
        DEPENDS ${font_files} ${font_dependency}
        COMMENT "${target}: embedding ${FONT_DEFAULT} fonts"
        VERBATIM
    )
    # the generated unit joins the target, which is what registers the faces at load (§11.3)
    target_sources(${target} PRIVATE ${units})
    # the generated header joins the include path, which the composition root and a static consumer include (§3.5)
    target_include_directories(${target} PUBLIC "${generated_dir}")
endfunction()

# generate the facade units of one ui component for a target, which wires them into its sources (§11.3, AD-03a, §14.2)
#
# the caller declares each imported ui file with its own call before the file that imports it, because the generated
# header must exist before the importer compiles. IMPORTS names the direct imports, which makes the importer's
# generation wait for their units; their own imports belong in their own call, so the graph stays explicit.
function(albor_build_ui_component target ui_source)
    # a helper without a target has nothing to attach the facade to (§14.2)
    if(NOT TARGET ${target})
        message(FATAL_ERROR "albor_build_ui_component: '${target}' is not a target")
    endif()
    # the generated units land in a per target directory, which must not sit in the source tree (§14.2)
    set(generated_dir "${CMAKE_BINARY_DIR}/generated/${target}")
    # a relative ui source is resolved against the caller's source directory, because the command runs in the build (§14.2)
    get_filename_component(ui_source "${ui_source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    # an import list is read out of the arguments, because the manifest and font flags follow it unchanged (§11.1, §11.2)
    set(ui_imports "")
    set(codegen_args "")
    set(reading_imports FALSE)
    foreach(argument IN LISTS ARGN)
        # the keyword opens the import list, which is not passed to the driver (§11.1)
        if(argument STREQUAL "IMPORTS")
            set(reading_imports TRUE)
            continue()
        endif()
        # an option closes the import list, because a driver flag is not a ui path (§11.1)
        if(reading_imports AND argument MATCHES "^-")
            set(reading_imports FALSE)
        endif()
        # an import path joins the list between the keyword and the next option (§11.1)
        if(reading_imports)
            list(APPEND ui_imports "${argument}")
        else()
            list(APPEND codegen_args "${argument}")
        endif()
    endforeach()
    # the unit stem is the source base, which is the file name the component compiles to (§11.3)
    get_filename_component(stem "${ui_source}" NAME_WE)
    # a source that is not there cannot generate a facade, so the build reports it before the tool runs (§14.2)
    if(NOT EXISTS "${ui_source}")
        message(FATAL_ERROR "albor_build_ui_component: '${target}' cannot find '${ui_source}'")
    endif()
    # two sources with one stem would write the same generated pair, so the second call is refused (§14.2)
    get_target_property(existing_stem_source ${target} "ALBOR_UI_STEM_${stem}")
    if(existing_stem_source)
        message(FATAL_ERROR "albor_build_ui_component: '${target}' already generates '${stem}' from '${existing_stem_source}'")
    endif()
    # the target records that a facade was generated, which the font helper uses to enforce its order (§11.1)
    set_target_properties(${target} PROPERTIES ALBOR_UI_COMPONENT_GENERATED TRUE)
    # the facade and its per-source asset pair are the outputs, which the build orders on (§14.2)
    set(units "${generated_dir}/${stem}.h" "${generated_dir}/${stem}.cpp" "${generated_dir}/${stem}_assets.h" "${generated_dir}/${stem}_assets.cpp")
    # the depfile records the png bytes the generator embedded, which an edit must rebuild (§6.4, §14.2)
    set(depfile "${generated_dir}/${stem}.d")
    # each imported file was declared by its own call, because its generated header must exist before this one compiles (§11.1)
    set(import_units "")
    # a relative import resolves beside the ui file, which is where the language resolves it (§11.1)
    get_filename_component(ui_directory "${ui_source}" DIRECTORY)
    foreach(import_source IN LISTS ui_imports)
        # an import path is made absolute against the ui file, unless the caller already named an absolute path (§11.1)
        get_filename_component(import_source "${import_source}" ABSOLUTE BASE_DIR "${ui_directory}")
        # the per-source registry answers with the units that source's call generated (§14.2)
        string(MAKE_C_IDENTIFIER "${import_source}" import_key)
        get_target_property(declared_units ${target} "ALBOR_UI_UNITS_${import_key}")
        # an import with no earlier call would compile before its header exists, so the graph is refused (§11.1)
        if(NOT declared_units)
            message(FATAL_ERROR "albor_build_ui_component: '${target}' imports '${import_source}' before declaring it; call albor_build_ui_component for the import first")
        endif()
        # the importer waits for every unit of the import, which orders the headers before its own compile (§11.1)
        list(APPEND import_units ${declared_units})
    endforeach()
    # a source declared twice would emit two rules for one output, so the second call is refused (§14.2)
    string(MAKE_C_IDENTIFIER "${ui_source}" source_key)
    get_target_property(existing_units ${target} "ALBOR_UI_UNITS_${source_key}")
    if(existing_units)
        message(FATAL_ERROR "albor_build_ui_component: '${target}' already generates '${ui_source}'")
    endif()
    # the font assets the target declared are passed to the compiler, which validates the ui selection (§11.1, AD-34)
    get_target_property(font_args ${target} ALBOR_FONT_ASSETS)
    get_target_property(default_family ${target} ALBOR_DEFAULT_FONT_FAMILY)
    # a target that declared no font passes no flag, which keeps the platform font path unchanged (§9.1)
    if(NOT font_args)
        set(font_args "")
    endif()
    # the default family follows the same rule, because a target without fonts has none to name (§9.1)
    if(NOT default_family)
        set(default_family "")
    endif()
    # the font flags are appended after the caller arguments, because the caller's manifest comes first (§11.3)
    set(font_flags "")
    if(font_args)
        list(APPEND font_flags --default-font-family "${default_family}" ${font_args})
    endif()
    # the codegen command resolves from the build tree's target or the installed package's tools (AD-19)
    _albor_driver(codegen_command codegen_dependency albor-codegen)
    # the driver compiles the ui file into the units, which write only when their content changed (§14.2, AD-03a)
    add_custom_command(
        OUTPUT ${units}
        COMMAND ${codegen_command} --input "${ui_source}" --output "${generated_dir}" --depfile "${depfile}" ${codegen_args} ${font_flags}
        DEPFILE "${depfile}"
        DEPENDS "${ui_source}" ${import_units} ${codegen_dependency}
        COMMENT "${target}: generating ${stem} from ${ui_source}"
        VERBATIM
    )
    # the generated units join the target, which is what compiles them with the rest (§14.1)
    target_sources(${target} PRIVATE ${units})
    # the generated directory joins the include path, which is where the facade header lives (§3.5, §11.3)
    target_include_directories(${target} PRIVATE "${generated_dir}")
    # the source registry lets a later importer find these units without generating them again (§11.1, §14.2)
    set_target_properties(${target} PROPERTIES "ALBOR_UI_UNITS_${source_key}" "${units}")
    # the stem registry refuses a second source that would rewrite the same generated pair (§14.2)
    set_target_properties(${target} PROPERTIES "ALBOR_UI_STEM_${stem}" "${ui_source}")
endfunction()

# generate the record structs a manifest declares for a target, because a repeat names them as element types (§11.2, AD-17, AD-13)
function(albor_build_native_record target manifest_source)
    # the generated units land in a per target directory, which must not sit in the source tree (§14.2)
    set(generated_dir "${CMAKE_BINARY_DIR}/generated/${target}")
    # the record names are only known once the manifest is parsed, so the build tracks a stamp rather than the headers (§11.2)
    # the headers reach the compile through the includes a generated facade writes, so they need not be listed as sources (§11.2, AD-17)
    set(stamp "${generated_dir}/records.stamp")
    # the glue command resolves from the build tree's target or the installed package's tools (AD-19)
    _albor_driver(glue_command glue_dependency albor-manifest-glue)
    # the driver compiles the manifest into the struct headers, which write only when their content changed (§11.2, AD-17)
    add_custom_command(
        OUTPUT "${stamp}"
        COMMAND ${glue_command} --input "${manifest_source}" --output "${generated_dir}"
        COMMAND "${CMAKE_COMMAND}" -E touch "${stamp}"
        DEPENDS "${manifest_source}" ${glue_dependency}
        COMMENT "${target}: generating records from ${manifest_source}"
        VERBATIM
    )
    # the stamp joins the sources, which is what orders the generation before anything includes a record (§11.2, §14.2)
    target_sources(${target} PRIVATE "${stamp}")
    # the generated directory joins the include path, which is where a record header lives (§3.5, §11.2)
    target_include_directories(${target} PRIVATE "${generated_dir}")
endfunction()

# generate the facade units of one native component for a target, which wires them into its sources (§11.2, AD-17, §14.2)
function(albor_build_native_component target manifest_source class_name)
    # the generated units land in a per target directory, which must not sit in the source tree (§14.2)
    set(generated_dir "${CMAKE_BINARY_DIR}/generated/${target}")
    # the module of the unit is the manifest base, which is what the driver reads the module from (§11.2)
    get_filename_component(module "${manifest_source}" NAME_WE)
    # the unit stem is the snake case class, which is how the facade files are named (§11.3)
    albor_component_stem(stem "${class_name}")
    # the facade header and its implementation unit are the outputs, which the build orders on (§14.2)
    set(units "${generated_dir}/${module}/${stem}.h" "${generated_dir}/${module}/${stem}.cpp")
    # the glue command resolves from the build tree's target or the installed package's tools (AD-19)
    _albor_driver(glue_command glue_dependency albor-manifest-glue)
    # the glue driver compiles the manifest into the units, which write only when their content changed (§14.2, AD-17)
    add_custom_command(
        OUTPUT ${units}
        COMMAND ${glue_command} --input "${manifest_source}" --output "${generated_dir}"
        DEPENDS "${manifest_source}" ${glue_dependency}
        COMMENT "${target}: generating ${class_name} from ${manifest_source}"
        VERBATIM
    )
    # the generated units join the target, which is what compiles them with the rest (§14.1)
    target_sources(${target} PRIVATE ${units})
    # the generated directory joins the include path, which is where the facade header lives (§3.5, §11.2)
    target_include_directories(${target} PRIVATE "${generated_dir}")
endfunction()